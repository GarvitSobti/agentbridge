{
  "name": "agent-bridge",
  "version": "0.0.0",
  "private": true,
  "description": "A local authenticated relay prototype for two developers' coding agents.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "check": "npm run check:docs && npm run typecheck && npm test",
    "check:docs": "node scripts/check-repo.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "demo:domain": "node examples/domain-handoff.mjs",
    "demo:storage": "node examples/storage-restart.mjs",
    "demo:pilot": "node examples/pilot-rehearsal.mjs",
    "relay:init": "node src/cli/relay.ts init",
    "relay": "node src/cli/relay.ts start",
    "beta:init": "node src/cli/relay.ts beta-init",
    "beta": "node src/cli/relay.ts beta-start",
    "connect": "node src/cli/connect.ts",
    "relay:credential": "node src/cli/relay.ts credential",
    "bridge": "node src/cli/bridge.ts",
    "mcp": "node src/mcp/stdio.ts",
    "pickup:watch": "node src/cli/pickup-watch.ts",
    "review:watch": "node src/cli/review-watch.ts"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "24.1.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "4.6.5"
  }
}
