{
  "name": "agent-bridge",
  "version": "0.0.0",
  "private": true,
  "description": "A shared inbox for two developers' coding agents; persistent request domain proof of concept.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "check": "npm run check:docs && npm run typecheck && npm test",
    "check:docs": "node scripts/check-repo.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "demo:domain": "node examples/domain-handoff.mjs",
    "demo:storage": "node examples/storage-restart.mjs"
  },
  "devDependencies": {
    "@types/node": "24.1.0",
    "typescript": "5.9.3"
  }
}
